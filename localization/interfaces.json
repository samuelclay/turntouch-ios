  "Turn Touch iOS/Views/Modal/Base.lproj/TTSwitchButtonModeViewController.xib": {
    "sha256": "52ceba4065459eb73ad54c49e117fd3acbe219dce049b72675d849a8e6264d4a",
    "strings": {
      "0Kv-gp-YFo.text": "If this is off, tapping buttons will select them for editing. If on, tapping buttons will perform their actions, just like on a Turn Touch remote, and a Change button will enable editing.",
      "0TL-9X-rEb.text": "Each of the four buttons has a single and a double tap action. By holding down a button for a half second, you switch into that button's app. Four apps ⨯ four buttons each = 16 buttons",
      "6Zt-0J-fgG.text": "12 button mode",
      "CBh-4i-bYO.text": "16 button mode",
      "dgu-WI-Aeh.text": "There are two button modes you can use with your Turn Touch.",
      "gIr-Q8-UNZ.text": "Buttons perform actions",
      "wg9-uU-2mZ.text": "Each of the four buttons has three types of button presses: single tap, double tap, and hold. Each of the three  button presses runs different actions."
    }
  },
  "Turn Touch iOS/Views/Options/Base.lproj/TTModeDoubleOptions.xib": {
    "sha256": "189a5bb4938f6b3b32dc06b90ead52135c42e1de199ca69a3729dcf839cea28a",
    "strings": {
      "0Qj-jz-TCD.text": "Disabling double tap allows you to use single taps in rapid succession (for example, changing volume) without triggering this double tap action. \n\nAdditionally, some single tap actions have a double tap action built in that will only work if this double-tap mode is disabled (for example, play/pause will go to the previous track on double tap).",
      "0uw-SL-RHg.text": "Enable double tap"
    }
  }
